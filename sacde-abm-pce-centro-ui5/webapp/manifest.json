{
  "_version": "1.85.0",
  "sap.app": {
    "id": "sacde.abm.pce.centro.ui5",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.27.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/abm-contexto/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "abm-pce-centro-inbound": {
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "semanticObject": "AdministracionPCECentro",
          "action": "display",
          "title": "Administrar PCE por Centro",
          "subTitle": "Monitor de Ajuste de Costos",
          "icon": "sap-icon://task",
          "info": "Ingrese aquí",
          "displayFormatHint": "standardWide"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.149.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.comp": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sacde.abm.pce.centro.ui5.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sacde.abm.pce.centro.ui5.view",
        "async": true,
        "viewPath": "sacde.abm.pce.centro.ui5.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RoutePmAprobador",
          "pattern": "pm-aprobador",
          "target": [
            "TargetPmAprobador"
          ]
        },
        {
          "name": "RouteAuditoria",
          "pattern": "auditoria",
          "target": [
            "TargetAuditoria"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetPmAprobador": {
          "id": "PmAprobador",
          "name": "PmAprobador"
        },
        "TargetAuditoria": {
          "id": "Auditoria",
          "name": "Auditoria"
        }
      }
    },
    "rootView": {
      "viewName": "sacde.abm.pce.centro.ui5.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "approuter-abm-pce-centro"
  }
}
